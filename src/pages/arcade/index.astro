---
import Base from '../../layouts/Base.astro';
import { base } from '../../lib/rich';
// Gallery stub. The real arcade (four games, cabinet art) is built after the front-room pick.
---
<Base title="Boardy Arcade" theme="arcade" bodyClass="crt" eggs={false}>
<main id="main" class="ar">
  <p class="ar-k">BOARDY ARCADE</p>
  <h1>CLOSED FOR<br />REFURBISHMENT</h1>
  <ul class="ar-m">
    <li><span>1</span> TAX MAN</li><li><span>2</span> MARGIN INVADERS</li><li><span>3</span> COMPOUND INTEREST</li><li><span>4</span> BREAK THE MARKET</li>
  </ul>
  <p class="ar-blink">INSERT COIN</p>
  <p class="ar-f">PARODY. NOT INVESTMENT ADVICE. NO REAL MONEY INVOLVED.</p>
  <a class="ar-back" href={base}>◄ BACK TO THE RESPECTABLE PART</a>
</main>
</Base>
<style is:global>
.t-arcade{--bg:#07060c;--fg:#e8fbff;background:#07060c radial-gradient(ellipse at 50% 40%,#1b1238 0,#07060c 70%)}
.ar{min-height:100vh;min-height:100svh;display:grid;align-content:center;justify-items:center;gap:1.6rem;padding:2rem 1rem;text-align:center;
  font-family:'Press Start 2P',ui-monospace,monospace;position:relative}
.ar::after{content:"";position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.28) 0 1px,transparent 1px 3px);mix-blend-mode:multiply}
.ar-k{font-size:clamp(.7rem,2.4vw,1rem);color:#ffd23f;letter-spacing:.2em}
.ar h1{font:400 clamp(1.3rem,5.5vw,3rem)/1.4 'Press Start 2P',monospace;color:#ff4fd8;text-shadow:0 0 12px rgba(255,79,216,.7),3px 3px 0 #2a0d5e}
.ar-m{list-style:none;padding:0;display:grid;gap:1rem;font-size:clamp(.62rem,2.2vw,.9rem);color:#7df9ff;text-align:left}
.ar-m span{color:#ffd23f;margin-right:1rem}
.ar-blink{color:#fff;font-size:clamp(.7rem,2.4vw,1rem);animation:blink 1.1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.ar-f{font:400 1.05rem/1.3 'VT323',monospace;color:#9aa3b5;letter-spacing:.06em}
.ar-back{font-size:.6rem;color:#7df9ff;line-height:1.8}
@media (prefers-reduced-motion:reduce){.ar-blink{animation:none}.ar::after{display:none}}
</style>
