---
import Base from '../../../layouts/Base.astro';
import Pic from '../../../components/Pic.astro';
import man from '../../../../public/img/manifest.json';
import { PLATE_SUBJECTS, PLATE_SUBJECTS_2, PLATE_STYLES, EARLIER } from '../../../content/plates';
import { base } from '../../../lib/rich';
const M = man as Record<string, unknown>;
let n = 0;
const items = [
  ...PLATE_SUBJECTS.flatMap(([slug, label, style]) => [1, 2].map((v) => ({ name: `${slug}-${v}`, label, style: PLATE_STYLES[style] }))),
  ...EARLIER.map(([name, label]) => ({ name, label, style: PLATE_STYLES.earlier })),
  ...PLATE_SUBJECTS_2.flatMap(([slug, label, style]) => [1, 2].map((v) => ({ name: `${slug}-${v}`, label, style: `${PLATE_STYLES[style]} · from your interests` }))),
].filter((i) => M[i.name]).map((i) => ({ ...i, n: ++n }));
---
<Base title="Pick the plates" theme="plates" eggs={false}>
<main id="main" class="pk">
  <header class="pk-h">
    <p class="pk-k">boardybell.com · N6 · plate options</p>
    <h1>Pick the engravings.</h1>
    <p>Each is shown on the navy it will sit on. Click any you like (as many as you want); your picks stay listed at the bottom. When done, press “Copy my picks” and paste the numbers back to me. Two go in the report’s plate row; extras can go elsewhere on the page.</p>
    <p class="pk-f"><a href={`${base}gallery/`}>Back to the gallery</a> · <a href={`${base}n/n6/#plates`}>See where they go (N6)</a></p>
  </header>
  <ul class="pk-grid">
    {items.map((i) => (
      <li>
        <button type="button" class="pk-card" data-n={i.n} aria-pressed="false">
          <span class="pk-num">{i.n}</span>
          <Pic name={i.name} alt={`${i.label}, ${i.style.toLowerCase()} engraving`} sizes="(min-width: 1200px) 22vw, (min-width: 700px) 30vw, 46vw" />
          <span class="pk-cap"><b>{i.label}</b><span>{i.style}</span></span>
        </button>
      </li>
    ))}
  </ul>
  <div class="pk-bar" role="status" aria-live="polite">
    <span>Picked: <b id="pk-list">none yet</b></span>
    <button type="button" id="pk-copy">Copy my picks</button>
    <button type="button" id="pk-clear">Clear</button>
  </div>
</main>
<script is:inline>
(() => {
  const K = 'bb.platePicks';
  let picks = []; try { picks = JSON.parse(localStorage.getItem(K) || '[]'); } catch {}
  const list = document.getElementById('pk-list');
  const paint = () => {
    document.querySelectorAll('.pk-card').forEach((b) => b.setAttribute('aria-pressed', picks.includes(+b.dataset.n)));
    list.textContent = picks.length ? picks.slice().sort((a, b) => a - b).join(', ') : 'none yet';
    try { localStorage.setItem(K, JSON.stringify(picks)); } catch {}
  };
  document.querySelectorAll('.pk-card').forEach((b) => b.addEventListener('click', () => { const n = +b.dataset.n; picks = picks.includes(n) ? picks.filter((x) => x !== n) : [...picks, n]; paint(); }));
  document.getElementById('pk-clear').onclick = () => { picks = []; paint(); };
  document.getElementById('pk-copy').onclick = async (e) => {
    const t = 'Plate picks: ' + (picks.length ? picks.slice().sort((a, b) => a - b).join(', ') : 'none');
    try { await navigator.clipboard.writeText(t); e.target.textContent = 'Copied'; } catch { prompt('Copy this:', t); }
    setTimeout(() => (e.target.textContent = 'Copy my picks'), 1800);
  };
  paint();
})();
</script>
</Base>
<style is:global>
.t-plates{--bg:#0D1626;--fg:#F3EBDD;background:#0D1626;color:#F3EBDD;-webkit-font-smoothing:auto}
.pk{padding:2.5rem var(--gutter) 7rem;max-width:90rem;margin-inline:auto;display:grid;gap:2rem}
.pk-h{display:grid;gap:.8rem;max-width:48rem}
.pk-k{font:500 .72rem/1.3 var(--label);letter-spacing:.16em;text-transform:uppercase;color:#D9B36C}
.pk-h h1{font:500 clamp(2rem,5vw,3.4rem)/1.05 var(--display)}
.pk-h p{color:#C5CAD6}
.pk-f a{color:#D9B36C}
.pk-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,15rem),1fr));gap:1.25rem}
.pk-card{all:unset;box-sizing:border-box;cursor:pointer;display:grid;gap:.6rem;width:100%;padding:.6rem;border:1px solid rgba(217,179,108,.22);position:relative;transition:border-color .2s,background .2s}
.pk-card:hover{border-color:rgba(217,179,108,.6)}
.pk-card:focus-visible{outline:2px solid #D9B36C;outline-offset:3px}
.pk-card[aria-pressed=true]{border:2px solid #D9B36C;background:rgba(217,179,108,.08);padding:calc(.6rem - 1px)}
.pk-card[aria-pressed=true] .pk-num{background:#D9B36C;color:#0D1626}
.pk-card[aria-pressed=true] .pk-num::after{content:" ✓"}
.pk-card img{aspect-ratio:1;object-fit:cover}
.pk-num{position:absolute;top:.9rem;left:.9rem;z-index:1;font:600 .8rem/1 var(--label);padding:.35rem .5rem;background:rgba(13,22,38,.85);color:#D9B36C;border:1px solid rgba(217,179,108,.5)}
.pk-cap{display:grid;gap:.15rem;font:400 .82rem/1.35 var(--label);color:#AEB4C2}
.pk-cap b{font:italic 500 1rem/1.3 var(--serif);color:#F3EBDD}
.pk-bar{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:center;justify-content:center;
  padding:.8rem 1rem;background:rgba(10,17,32,.96);border-top:1px solid rgba(217,179,108,.4);font:400 .9rem/1.3 var(--label)}
.pk-bar b{color:#D9B36C}
.pk-bar button{font:500 .72rem/1 var(--label);letter-spacing:.14em;text-transform:uppercase;padding:.7rem 1rem;cursor:pointer;border:1px solid #D9B36C;background:#D9B36C;color:#0D1626}
.pk-bar #pk-clear{background:transparent;color:#D9B36C}
</style>
