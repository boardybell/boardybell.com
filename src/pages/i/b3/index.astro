---
import Base from '../../../layouts/Base.astro';
import Overqualified from '../../../components/Overqualified.astro';
import '../../../styles/i/b.css';
import { ITER } from '../../../content/iterations';
const it = ITER.find((x) => x.id === 'b3')!;
---
<Base title="Boardy" theme="b3">
  <Overqualified v={3} />
  <a class="gal-back" href={import.meta.env.BASE_URL}>Gallery · {it.id.toUpperCase()} {it.name}</a>
</Base>
