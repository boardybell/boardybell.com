---
import Base from '../../../layouts/Base.astro';
import Dossier from '../../../components/Dossier.astro';
import '../../../styles/i/a.css';
import { ITER } from '../../../content/iterations';
const it = ITER.find((x) => x.id === 'a1')!;
---
<Base title="Boardy" theme="a1">
  <Dossier v={1} />
  <a class="gal-back" href={`${import.meta.env.BASE_URL}gallery/`}>Gallery · {it.id.toUpperCase()} {it.name}</a>
</Base>
