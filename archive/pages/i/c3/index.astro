---
import Base from '../../../layouts/Base.astro';
import Report from '../../../components/Report.astro';
import '../../../styles/i/c.css';
import { ITER } from '../../../content/iterations';
const it = ITER.find((x) => x.id === 'c3')!;
---
<Base title="Boardy" theme="c3">
  <Report v={3} />
  <a class="gal-back" href={`${import.meta.env.BASE_URL}gallery/`}>Gallery · {it.id.toUpperCase()} {it.name}</a>
</Base>
